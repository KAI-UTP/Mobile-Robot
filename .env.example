# Copy to .env and change these before running anywhere but your own machine.
#
#   cp .env.example .env
#
# .env is gitignored. docker compose reads it automatically; every value here
# has a working default in docker-compose.yml, so the stack runs without it.

# ── Ports ────────────────────────────────────────────────────────────────────
# Not 3000: the SmartClean Twin project's Grafana usually holds that.
GRAFANA_PORT=3001

# ── Credentials ──────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

INFLUX_USER=admin
INFLUX_PASSWORD=roommapper123
# Any non-empty string. Grafana and the telemetry sink must use the same one.
INFLUX_TOKEN=roommapper-super-secret-token
INFLUX_ORG=roommapper
INFLUX_BUCKET=roommapper

# ── Robot ────────────────────────────────────────────────────────────────────
ROBOT_ID=MR3W01

# Which room the map is scored against on the /compare screen.
# One of: rectangular, l-shaped, furnished
REFERENCE_ROOM=rectangular

# ── Data source ──────────────────────────────────────────────────────────────
# sim  = the built-in virtual robot, no hardware needed
# mqtt = a real robot publishing telemetry (run services/robot-agent on the
#        host, since the serial ports live there rather than in a container)
SOURCE=sim

# Simulation speed multiplier. 1 is real time; 4 makes a demo watchable.
SIM_SPEED=4

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
INFLUX_RETENTION=7d
